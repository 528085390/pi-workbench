{
  "apiVersion": "1",
  "schemaVersion": 4,
  "note": "C06 golden fixture：同一 db 重建 server 后，after=resumeAfterSeq 的 WS 回放必须逐字段等于 expectedReplay（完整帧：seq/sessionKey/type/source/ts/payload/idempotencyKey；seq 单调、不重复、不断档）。ts 写入时决定，测试比对前归一为 <iso8601>。seq 由 SQLite AUTOINCREMENT 分配，空库首次写入从 1 开始。",
  "events": [
    {
      "sessionKey": "claude:sess-a",
      "type": "token",
      "payload": {
        "text": "hello"
      },
      "source": "claude",
      "idempotencyKey": "golden-1"
    },
    {
      "sessionKey": "claude:sess-a",
      "type": "tool_call",
      "payload": {
        "name": "Read",
        "input": {
          "path": "a.ts"
        }
      },
      "source": "claude",
      "idempotencyKey": "golden-2"
    },
    {
      "sessionKey": "codex:sess-b",
      "type": "state_update",
      "payload": {
        "state": "running"
      },
      "source": "codex",
      "idempotencyKey": "golden-3"
    },
    {
      "sessionKey": "claude:sess-a",
      "type": "state_update",
      "payload": {
        "state": "idle",
        "stopReason": "end_turn"
      },
      "source": "claude",
      "idempotencyKey": "golden-4"
    },
    {
      "sessionKey": "codex:sess-b",
      "type": "notice",
      "payload": {
        "text": "restart"
      },
      "source": "codex",
      "idempotencyKey": "golden-5"
    }
  ],
  "resumeAfterSeq": 3,
  "expectedReplay": [
    {
      "seq": 4,
      "sessionKey": "claude:sess-a",
      "type": "state_update",
      "source": "claude",
      "ts": "<iso8601>",
      "payload": {
        "state": "idle",
        "stopReason": "end_turn"
      },
      "idempotencyKey": "golden-4"
    },
    {
      "seq": 5,
      "sessionKey": "codex:sess-b",
      "type": "notice",
      "source": "codex",
      "ts": "<iso8601>",
      "payload": {
        "text": "restart"
      },
      "idempotencyKey": "golden-5"
    }
  ]
