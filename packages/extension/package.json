{
  "name": "@pi-workbench/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi-workbench.plugin.ts"
    ]
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.plugin.json",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\""
  },
  "dependencies": {
    "@pi-workbench/shared": "workspace:*",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
